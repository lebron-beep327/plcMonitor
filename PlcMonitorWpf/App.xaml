<Application x:Class="PlcMonitorWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBackground" Color="#101827" />
    <SolidColorBrush x:Key="PanelBackground" Color="#172235" />
    <SolidColorBrush x:Key="PanelBorder" Color="#2A405D" />
    <SolidColorBrush x:Key="Primary" Color="#27B6F6" />
    <SolidColorBrush x:Key="TextPrimary" Color="#ECF7FF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#91A7C0" />
    <SolidColorBrush x:Key="Success" Color="#35D07F" />
    <SolidColorBrush x:Key="Danger" Color="#FF6474" />

    <Style TargetType="{x:Type Border}" x:Key="Panel">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#287BB2" />
      <Setter Property="BorderBrush" Value="#3A98D2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="#101827" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#234A68" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#1D334B" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ListViewItem}">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Resources>
</Application>
