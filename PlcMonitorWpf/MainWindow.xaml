<Window x:Class="PlcMonitorWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC 监控" Height="760" Width="1320" MinHeight="600" MinWidth="1000"
        Background="{StaticResource PageBackground}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="62" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="PLC 设备监控" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="简洁版 · 实时状态与报警" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Ellipse Width="10" Height="10" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Text="系统运行中" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CurrentTime}" Margin="24,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <!-- 左：PLC 列表 -->
      <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,14,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="PLC 列表" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" />
          <ListBox Grid.Row="1" ItemsSource="{Binding PlcDevices}" SelectedItem="{Binding SelectedPlc, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="12,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding IpAddress}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 中：当前 PLC 摄像头画面 -->
      <Grid Grid.Column="1" Margin="0,0,14,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding SelectedPlc.Name}" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <TextBlock Text="PLC IP：" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <TextBox Width="145" Text="{Binding SelectedPlc.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="保存" Command="{Binding SavePlcIpCommand}" Padding="10,5" Margin="8,0,0,0" />
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{Binding SelectedPlc.StatusBrush}" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedPlc.StatusText}" Foreground="White" FontWeight="SemiBold" />
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
              <TextBlock Text="实时视频" FontSize="17" FontWeight="SemiBold" />
              <Border DockPanel.Dock="Right" Background="#31445E" CornerRadius="12" Padding="10,4">
                <TextBlock Text="摄像头未连接" Foreground="{StaticResource TextSecondary}" FontSize="12" />
              </Border>
            </DockPanel>
            <Border Grid.Row="1" Background="#080E17" BorderBrush="#2A405D" BorderThickness="1" CornerRadius="6" Margin="0,18,0,18">
              <Grid>
                <Border Width="76" Height="76" CornerRadius="38" Background="#13283A" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="CAM" Foreground="{StaticResource Primary}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,124,0,0">
                  <TextBlock Text="等待摄像头接入" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="接入后将在此显示实时画面" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" />
                </StackPanel>
                <Border Background="#172235" CornerRadius="4" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                  <TextBlock Text="通道 01" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                </Border>
              </Grid>
            </Border>
            <DockPanel Grid.Row="2">
              <TextBlock Text="摄像头 IP：" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
              <TextBox Width="155" Text="{Binding CameraIp, UpdateSourceTrigger=PropertyChanged}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="保存摄像头 IP" Command="{Binding SaveCameraIpCommand}" />
                <Button Content="开始预览" Background="#58677B" BorderBrush="#718096" Margin="0" />
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="提示：" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Grid.Column="1" Text="摄像头接入功能将在确定型号和视频协议后启用。" FontWeight="SemiBold" />
          </Grid>
        </Border>
      </Grid>

      <!-- 右：报警和趋势 -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="180" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
              <TextBlock Text="报警信息" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AlarmCount, StringFormat=共 {0} 条}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondary}" />
            </DockPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Alarms}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#2A405D" BorderThickness="0,0,0,1" Padding="0,10">
                    <StackPanel>
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="温度趋势（模拟）" FontSize="17" FontWeight="SemiBold" />
            <Viewbox Grid.Row="1" Stretch="Fill" Margin="0,12,0,0">
              <Canvas Width="250" Height="105">
                <Line X1="0" X2="250" Y1="88" Y2="88" Stroke="#38506E" StrokeThickness="1" />
                <Polyline Points="{Binding SelectedPlc.TrendPoints}" Stroke="{StaticResource Primary}" StrokeThickness="3" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
